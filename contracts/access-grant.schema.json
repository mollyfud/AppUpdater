{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.local/contracts/app-updater/1/access-grant.schema.json",
  "title": "AccessGrant",
  "description": "Contract app-updater/1 (v1.1.0): per-person access grant stored at _grants/<sha256(token) hex>.json in R2. The token itself is never stored.",
  "type": "object",
  "required": ["id", "name", "apps", "created", "revoked"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$",
      "description": "First 16 hex chars of sha256(token). Safe to show; used to revoke."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Who the grant is for." },
    "apps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "string",
        "anyOf": [{ "const": "*" }, { "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z0-9_]+)+$" }]
      },
      "description": "appIds this person may install, or [\"*\"] for every shareable app."
    },
    "created": { "type": "string", "format": "date-time" },
    "expires": { "type": "string", "format": "date-time", "description": "Absent = never expires." },
    "revoked": { "type": "boolean" },
    "revokedAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string", "maxLength": 200 }
  },
  "additionalProperties": true
}
